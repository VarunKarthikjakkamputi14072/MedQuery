# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://medquery:medquery@postgres:5432/medquery

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Pinecone ---------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=medquery
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=dotproduct

# --- Storage (mock S3 = local filesystem) -----------------------------------
STORAGE_DIR=/data/storage

# --- Async ingestion ---------------------------------------------------------
# "background" runs FastAPI post-response tasks for local dev; "celery" uses
# Redis-backed workers and is what docker-compose enables.
INGEST_QUEUE_BACKEND=background
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# --- PHI/PII redaction -------------------------------------------------------
# Regex is deterministic and has no NLP model dependency. Set to "presidio" to
# use Microsoft Presidio when its spaCy model is available in the environment.
REDACTION_PROVIDER=regex

# --- CORS -------------------------------------------------------------------
# Comma separated list. Defaults already allow the Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# --- Provider mode ----------------------------------------------------------
# Set to "true" to bypass external APIs (uses deterministic fakes for
# embeddings + vector store + LLM). Useful for local dev and CI.
USE_FAKE_PROVIDERS=true

# --- Optional: medical entity extraction ------------------------------------
# The /extract endpoint will automatically use scispaCy's en_core_sci_sm model
# when installed; otherwise it falls back to a regex extractor.
