# Database
DATABASE_URL=postgresql+asyncpg://medquery:medquery@localhost:5432/medquery

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=medquery
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Storage (mock S3 = local filesystem)
STORAGE_DIR=./storage

# CORS
CORS_ORIGINS=http://localhost:3000

# Set to "true" to bypass external APIs (uses deterministic fakes for embeddings + LLM)
USE_FAKE_PROVIDERS=true
