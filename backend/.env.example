# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://medquery:medquery@postgres:5432/medquery

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Transit (self-hosted AI gateway) ---------------------------------------
# When set, LLM + embeddings route through Transit instead of OpenAI directly:
# one metered, cached af_ key, so repeated questions/embeddings hit Redis and
# cost nothing. Takes precedence over OpenAI/Groq. Leave blank to call directly.
TRANSIT_BASE_URL=https://apiforge-jnwp.onrender.com/api/v1
TRANSIT_API_KEY=af_...
TRANSIT_CHAT_MODEL=meta/llama-3.3-70b-instruct
TRANSIT_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
TRANSIT_EMBEDDING_DIM=1024

# --- Pinecone ---------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=medquery
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Storage (mock S3 = local filesystem) -----------------------------------
STORAGE_DIR=/data/storage

# --- CORS -------------------------------------------------------------------
# Comma separated list. Defaults already allow the Next.js dev server.
CORS_ORIGINS=http://localhost:3000

# --- Provider mode ----------------------------------------------------------
# Set to "true" to bypass external APIs (uses deterministic fakes for
# embeddings + vector store + LLM). Useful for local dev and CI.
USE_FAKE_PROVIDERS=true

# --- Optional: medical entity extraction ------------------------------------
# The /extract endpoint will automatically use scispaCy's en_core_sci_sm model
# when installed; otherwise it falls back to a regex extractor.
