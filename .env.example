# Top-level env file consumed by docker-compose.

# Providers auto-detect per key:
#   - Set OPENAI_API_KEY  -> real GPT-4o-mini + embeddings (reads/answers from citations).
#   - Set PINECONE_API_KEY -> real Pinecone vector store (OPTIONAL; otherwise an
#     in-memory cosine store is used, so OpenAI alone is enough for real answers).
#   - Set no keys          -> deterministic fakes (zero-cost demo, full pipeline).
# USE_FAKE_PROVIDERS forces the fakes even when keys are present (tests/demo).
# Leave it unset (or "false") for auto-detection; set "true" to force fakes.
USE_FAKE_PROVIDERS=false

# OpenAI — set this key to turn on the real LLM + embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone — OPTIONAL. Without a key, an in-memory vector store is used.
PINECONE_API_KEY=
PINECONE_INDEX=medquery
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Postgres (override only if you change docker-compose.yml)
POSTGRES_USER=medquery
POSTGRES_PASSWORD=medquery
POSTGRES_DB=medquery

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
