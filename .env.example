# Top-level env file consumed by docker-compose.

# Set to "false" to call the real OpenAI + Pinecone APIs.
USE_FAKE_PROVIDERS=true

# OpenAI (required when USE_FAKE_PROVIDERS=false)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone (required when USE_FAKE_PROVIDERS=false)
PINECONE_API_KEY=
PINECONE_INDEX=medquery
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Postgres (override only if you change docker-compose.yml)
POSTGRES_USER=medquery
POSTGRES_PASSWORD=medquery
POSTGRES_DB=medquery

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
